# Backend
VITE_API_URL=http://localhost:8000

# Optional PostHog Cloud session replay / product analytics.
# Leave VITE_POSTHOG_KEY empty to disable browser observability completely.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Privacy-safe default: replay masks all page text and all form inputs.
# For a controlled internal debugging environment only, set this to false if
# seeing rendered UI text is necessary. Input contents remain masked either way.
VITE_POSTHOG_MASK_ALL_TEXT=true
